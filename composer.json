{
    "name": "derrick/auth-system",
    "description": "OAuth2 Identity Provider with Slim 4",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Derrick",
            "email": "muriithiderrick56@gmail.com"
        }
    ],
    "require": {
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "lcobucci/jwt": "^5.6",
        "doctrine/dbal": "^4.4",
      "ext-openssl": "*",
        "robmorgan/phinx": "^0.16.10"
